# MongoDB connection string and database name for server-side use only.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=contract_guard

# Optional local simulated contract receiver (must match its RECEIVER_TOKEN).
# Set both values to enable provisioning on API version upload.
# CONTRACT_RECEIVER_WS_URL=ws://127.0.0.1:9910/ws
# CONTRACT_RECEIVER_TOKEN=replace-with-a-secret-at-least-16-characters
